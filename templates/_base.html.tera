{% extends "_base_core.html.tera" %}

{% block favicon %}
<link rel="icon" type="image/png" sizes="32x32" href="/static/images/icon-32.png?v={{ salt }}">
<link rel="icon" type="image/png" sizes="16x16" href="/static/images/icon-16.png?v={{ salt }}">
<link rel="icon" type="image/png" sizes="192x192" href="/static/images/icon-192.png?v={{ salt }}">
<link rel="icon" href="/static/images/favicon-app.ico?v={{ salt }}" sizes="any">
<link rel="icon" type="image/svg+xml" href="/static/images/favicon-vault.svg?v={{ salt }}">
<link rel="apple-touch-icon" href="/static/images/apple-touch-icon.png?v={{ salt }}">
{% endblock %}

{% block body_class %}app-shell{% endblock %}

{% block header %}
<header class="app-top">
  <a class="app-top__logo" href="/deals/">
    {# Light theme: white-field mark; dark theme: dark-field mark #}
    <img class="app-top__mark when-light" src="/static/images/icon-white.png?v={{ salt }}" alt="" width="28" height="28">
    <img class="app-top__mark when-dark" src="/static/images/mark.png?v={{ salt }}" alt="" width="28" height="28">
    <span>EscrowNad</span>
  </a>
  <nav class="app-top__nav">
    <a class="app-top__link" href="/deals/">Offers</a>
    <a class="app-top__link" href="/about/">About</a>
    <a class="app-top__link" href="/oracle/">How it works</a>
  </nav>
  <div class="app-top__right">
    <a class="app-top__cta" href="/deals/new/" title="Add listing">
      <span class="ico ico--plus" aria-hidden="true"></span>
      <span class="cta-label">Add</span>
    </a>
    {% if user %}
      <span class="app-top__chip" data-wallet-address title="Connected wallet">wallet</span>
    {% else %}
      <button type="button" class="app-top__cta app-top__cta--solid"
              data-wallet-connect data-wallet-prefer="phantom"
              data-redirect-after="/deals/">
        <span class="ico ico--wallet" aria-hidden="true"></span>
        <span class="cta-label">Connect Phantom</span>
      </button>
    {% endif %}
  </div>
</header>
{% endblock header %}

{% block footer %}
<footer class="app-foot">
  <div class="app-foot__left">
    <span>© {{ now_ts() | date(format="%Y") }} EscrowNad</span>
    <span class="dim">v {{ salt }}</span>
    <span class="dim">create at <span data-server-ms>—</span>&nbsp;ms</span>
  </div>
  <div class="app-foot__right">
    <button class="app-foot__btn theme-toggle" type="button" data-theme-toggle aria-label="theme">
      <span class="when-dark ico ico--sun ico--sm" aria-hidden="true"></span>
      <span class="when-light ico ico--moon ico--sm" aria-hidden="true"></span>
      <span class="when-dark">Light</span>
      <span class="when-light">Dark</span>
    </button>
    {% if user %}
      <button class="app-foot__btn" type="button" data-wallet-logout>
        <span class="ico ico--logout ico--sm" aria-hidden="true"></span>
        Disconnect
      </button>
    {% endif %}
  </div>
</footer>
{% endblock footer %}

{% block scripts_extra %}
<script src="/static/js/wallet.js?v={{ salt }}"></script>
{% endblock %}
