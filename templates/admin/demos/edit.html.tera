{# Reference new/edit form for a domain entity. Mirrors the platform pattern in
   templates/admin/constants/edit.html.tera. Page::load() supplies `demo`, with
   dmo_id=0 for a new one. Field names match the model, the params and the SQL —
   one struct end to end. #}
{% extends "_base.html.tera" %}

{% block title %}Demo · {{ constants.site_title | default(value="forge") }}{% endblock %}

{% block content %}
{% <admin_detail title="Demo" back_url="/admin/demos/"> %}
  <form class="ds-dialog__form admin-form">
    {{ <hidden name="id" value={demo.dmo_id | str} data_type="integer" /> }}

    <div class="admin-form__row">
      {{ <field name="dmo_code" label="Code" placeholder="alpha / beta / ..."
                value={demo.dmo_code | default(value="", boolean=true)} /> }}

      {{ <bool_toggle name="dmo_is_enable" label="Active" width="narrow"
                 checked={demo.dmo_is_enable} /> }}
    </div>

    {{ <field name="dmo_title" label="Title"
              placeholder="a human-readable title"
              value={demo.dmo_title | default(value="", boolean=true)} /> }}

    {{ <field name="dmo_note" label="Note" width="wide"
              placeholder="free-form text"
              value={demo.dmo_note | default(value="", boolean=true)} /> }}

    {{ <form_actions handler="demos_save" cancel_url="/admin/demos/" /> }}
  </form>
{% </admin_detail> %}
{% endblock %}
