{% extends "_base.html.tera" %}

{% block title %}{{ constants.site_title | default(value="EscrowNad") }}{% endblock %}

{% block content %}
<main class="home">
  <section class="home__hero">
    <p>
      <img src="/static/brand/wordmark.png" alt="EscrowNad" style="max-height:48px;height:auto">
    </p>
    <h1>Settle on proof</h1>
    <p class="lead">
      Proof-escrow on <strong>Monad</strong>. Settlement: <strong>USDC</strong>.
      First asset: <strong>IPv4</strong> (RIPE PA/PI). USDC unlocks only on oracle fact.
    </p>
    <p>
      <a class="ds-btn ds-btn--primary" href="/deals/">Browse deals</a>
      <a class="ds-btn" href="/oracle/">What is the oracle?</a>
      <a class="ds-btn" href="/admin/">Admin</a>
    </p>
  </section>
</main>
{% endblock %}
