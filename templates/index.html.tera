{# Private splash — wallet-only. Connect top-right (fintech). After connect → /deals/. EN only. #}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>EscrowNad</title>
  <meta name="robots" content="noindex">
  <link rel="icon" type="image/png" sizes="32x32" href="/static/images/icon-32.png?v={{ salt }}">
  <link rel="icon" type="image/png" sizes="16x16" href="/static/images/icon-16.png?v={{ salt }}">
  <link rel="icon" type="image/png" sizes="192x192" href="/static/images/icon-192.png?v={{ salt }}">
  <link rel="icon" href="/static/images/favicon-app.ico?v={{ salt }}" sizes="any">
  <link rel="icon" type="image/svg+xml" href="/static/images/favicon-vault.svg?v={{ salt }}">
  <link rel="apple-touch-icon" href="/static/images/apple-touch-icon.png?v={{ salt }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Mulish:wght@200;300;400;500;600;700;800&display=swap">
  <link rel="stylesheet" href="/static/css/tokens.css?v={{ salt }}">
  <link rel="stylesheet" href="/shared/css/base.css?v={{ salt }}">
  <link rel="stylesheet" href="/shared/css/toast.css?v={{ salt }}">
  <link rel="stylesheet" href="/static/css/landing.css?v={{ salt }}">
  <link rel="stylesheet" href="/static/css/site.css?v={{ salt }}">
</head>
<body class="landing-app">
  <header class="app-bar">
    <a class="app-bar__brand" href="/">
      <img src="/static/images/mark.png?v={{ salt }}" alt="" width="28" height="28">
      <span>ESCROW<b>·</b>NAD</span>
    </a>
    <div class="app-bar__actions">
      {% if user %}
        <a class="ds-btn ds-btn--primary" href="/deals/">Open offers</a>
      {% else %}
        <button type="button"
                class="ds-btn ds-btn--primary"
                data-wallet-connect
                data-redirect-after="/deals/">
          Connect wallet
        </button>
      {% endif %}
    </div>
  </header>

  <div class="wrap">
    <h1 class="lead">Settle on proof.</h1>
    <p class="sub">Proof-escrow on Monad. USDC unlocks only on external fact.</p>
    <div class="enter">
      {% if user %}
        <a href="/deals/">Browse offers</a>
      {% else %}
        <button type="button" data-wallet-connect data-redirect-after="/deals/">Connect wallet</button>
      {% endif %}
    </div>
    <p class="sub" data-wallet-status></p>
  </div>
  <div class="foot">© EscrowNad · Monad</div>

  {% if not user %}
  <input type="hidden" id="ws_url" value="{{ ws_url }}">
  <div id="toast-root"></div>
  <script src="https://cdn.jsdelivr.net/npm/@msgpack/msgpack@3.0.0-beta3/dist.es5+umd/msgpack.min.js"
          integrity="sha384-vUkIRBsoVitNTUNfC9MIDBQf7TZCx+hOi7JsClrFp1kdwYFxA85lo0PZs/zm2Uqj"
          crossorigin="anonymous"></script>
  <script src="/shared/js/msgpack-shim.js?v={{ salt }}"></script>
  <script src="https://cdn.jsdelivr.net/npm/spark-md5@3.0.2/spark-md5.min.js"
          integrity="sha384-WAahC3S+69Co45zyyuhCjvdMwo7a42Yn0mM0IgZIUlYNebG24AVkPUltj3BQnM85"
          crossorigin="anonymous"></script>
  <script type="importmap">
  {
    "imports": {
      "forge/toast":      "/shared/js/toast.js?v={{ salt }}",
      "forge/ws":         "/shared/js/ws-client.js?v={{ salt }}",
      "forge/form":       "/shared/js/form.js?v={{ salt }}",
      "forge/confirm":    "/shared/js/confirm.js?v={{ salt }}",
      "forge/theme":      "/shared/js/theme-mod.js?v={{ salt }}",
      "forge/ui-actions": "/shared/js/ui-actions.js?v={{ salt }}",
      "forge/utils":      "/shared/js/utils.js?v={{ salt }}"
    }
  }
  </script>
  <script type="module" src="/shared/js/bootstrap.js?v={{ salt }}"></script>
  <script src="/static/js/wallet.js?v={{ salt }}"></script>
  {% else %}
  {# Logged-in still needs wallet.js for disconnect / address chip on other pages via _base #}
  {% endif %}
</body>
</html>
