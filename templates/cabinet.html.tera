{% extends "_base.html.tera" %}

{% block title %}My deals · EscrowNad{% endblock %}

{% block content %}
<main class="app-main">
  {% if not market_allowed %}
  {% include "deals/_market_gate.html.tera" %}
  {% else %}
  <div class="app-main__bar">
    <div>
      <h1 class="app-main__title">My deals</h1>
      <p class="app-main__sub muted">Offers and buys linked to your wallet.</p>
    </div>
    <a class="app-top__cta" href="/deals/new/" title="Add listing">
      <span class="ico ico--plus" aria-hidden="true"></span>
      Add
    </a>
  </div>

  {% if deals | length == 0 %}
  <p class="muted">No deals yet. <a href="/deals/">Browse offers</a> or <a href="/deals/new/">add one</a>.</p>
  {% else %}
  <div class="offer-grid">
    {% for d in deals %}
    <a class="offer-card" href="/deals/{{ d.del_hash }}/">
      <div class="offer-card__top">
        <span class="status status--{{ d.del_status }}">{{ d.del_status }}</span>
        <code>{{ d.resource_kind }}</code>
      </div>
      <h2 class="offer-card__title rich">{{ d.del_title | default(value="Untitled") | safe }}</h2>
      <p class="offer-card__prefix"><code>{{ d.prefix }}</code></p>
    </a>
    {% endfor %}
  </div>
  {% endif %}
  {% endif %}
</main>
{% endblock %}
