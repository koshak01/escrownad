{# The project's own 404 page — overrides the platform one. #}
{% extends "_base.html.tera" %}

{% block title %}Not found · EscrowNad{% endblock %}

{% block content %}
<main class="app-main">
  <section class="err">
    <span class="err__code">404</span>
    <h1 class="err__title">No such page</h1>
    <p class="err__lead">
      The address does not exist, or the listing behind it is gone.
    </p>

    <p class="err__note">
      Lot pages live at <code>/deals/&lt;hash&gt;/</code> — a long address, not a number.
      Old numeric links stopped working when we moved to hashes.
    </p>

    <div class="err__actions">
      <a class="app-top__cta app-top__cta--solid" href="/deals/">Browse offers</a>
      <a class="app-top__btn" href="/">Home</a>
    </div>

    {% if path %}
    <p class="err__id">Requested: <code>{{ path }}</code></p>
    {% endif %}
  </section>
</main>
{% endblock %}
