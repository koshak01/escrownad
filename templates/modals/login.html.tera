{# Login modal — EN only. Password first; one wallet connect (Phantom/MetaMask/any). #}
<div class="ds-dialog ds-dialog--info">
  <p class="ds-dialog__text">Sign in</p>
  <form class="ds-dialog__form">
    {{ <field name="email"    type="text"     placeholder="email"    required={true} /> }}
    {{ <field name="password" type="password" placeholder="password" required={true} /> }}
    {{ <hidden name="redirect_after" value={redirect_after} /> }}

    <div class="ds-dialog__actions">
      {{ <button label="Sign in" type="submit" variant="primary" handler="login" icon="login" /> }}
      {{ <button label="Cancel"                 variant="ghost"   modal_close={true} /> }}
    </div>
  </form>

  <div class="wallet-login">
    <p class="wallet-login__or">or</p>
    <button type="button"
            class="ds-btn"
            data-wallet-connect
            data-redirect-after="{{ redirect_after }}">
      Connect wallet
    </button>
    <p class="wallet-login__hint muted">Phantom, MetaMask, or any EVM wallet</p>
    <p class="wallet-login__status muted" data-wallet-status></p>
  </div>
</div>
