{# The project's own 500 page — overrides the platform one, which is in Russian
   and carries the platform's branding. It extends our `_base.html.tera`: our
   favicon, our header and footer, English product copy. #}
{% extends "_base.html.tera" %}

{% block title %}Something broke · EscrowNad{% endblock %}

{% block content %}
<main class="app-main">
  <section class="err">
    <span class="err__code">500</span>
    <h1 class="err__title">Something broke on our side</h1>
    <p class="err__lead">
      Not your fault and not your wallet. The page failed to render — we already
      know about it and are looking.
    </p>

    <p class="err__note">
      <strong>Your money is safe.</strong> Funds live in the escrow contract on-chain,
      not in this page. Nothing is lost while the site is misbehaving, and any deal
      you already funded can still be refunded to you after its deadline.
    </p>

    <div class="err__actions">
      <a class="app-top__cta app-top__cta--solid" href="/deals/">Back to offers</a>
      <a class="app-top__btn" href="/">Home</a>
    </div>

    {% if error_id %}
    <p class="err__id">Incident code: <code>{{ error_id }}</code></p>
    {% endif %}
  </section>
</main>
{% endblock %}
