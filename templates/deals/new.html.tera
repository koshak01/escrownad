{% extends "_base.html.tera" %}

{% block title %}Add listing · EscrowNad{% endblock %}

{% block content %}
<main class="app-main">
  {% if not user %}
  <p class="app-hint">
    <button type="button" class="app-top__cta app-top__cta--solid"
            data-wallet-connect data-redirect-after="/deals/new/">
      <span class="ico ico--wallet" aria-hidden="true"></span>
      Connect wallet
    </button>
  </p>
  {% else %}
  <section class="app-form">
    <h1 class="app-form__title">Add listing</h1>
    <form class="ds-dialog__form" id="listing-form">
      <div class="side-toggle" role="radiogroup" aria-label="Listing side">
        <label class="side-toggle__opt">
          <input type="radio" name="listing_side" value="offer"
                 {% if listing_side != "request" %}checked{% endif %}>
          <span class="ico ico--offer" aria-hidden="true"></span>
          Offer
        </label>
        <label class="side-toggle__opt">
          <input type="radio" name="listing_side" value="request"
                 {% if listing_side == "request" %}checked{% endif %}>
          <span class="ico ico--request" aria-hidden="true"></span>
          Request
        </label>
      </div>
      {{ <field name="asset_type" type="text" label="Type" placeholder="ip | domain | property | work | other" required={true} /> }}
      {{ <field name="del_title" type="text" label="Description" placeholder="Short description" required={true} /> }}
      {{ <field name="prefix" type="text" label="Resource" placeholder="prefix / domain / address / id" required={true} /> }}
      {{ <field name="resource_kind" type="text" label="Subtype" placeholder="PA | PI | n/a" /> }}
      {{ <field name="from_org" type="text" label="From" /> }}
      {{ <field name="to_org" type="text" label="To" /> }}
      {{ <field name="del_amount" type="text" label="Price USDC" placeholder="1500" required={true} /> }}
      {{ <field name="del_note" type="textarea" label="Terms" /> }}
      {{ <hidden name="publish" value="true" /> }}
      <div class="app-form__actions">
        {{ <button label="Publish" type="submit" variant="primary" handler="deals_save" /> }}
        <a class="app-top__btn" href="/deals/">Cancel</a>
      </div>
    </form>
  </section>
  {% endif %}
</main>
{% endblock %}
