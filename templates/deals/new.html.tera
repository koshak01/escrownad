{% extends "_base.html.tera" %}

{% block title %}Add listing · EscrowNad{% endblock %}

{% block content %}
<main class="app-main">
  {% if not user %}
  <p class="app-hint">
    <button type="button" class="app-top__cta app-top__cta--solid"
            data-wallet-connect data-redirect-after="/deals/new/">
      <span class="ico ico--wallet" aria-hidden="true"></span>
      Connect wallet
    </button>
  </p>
  {% else %}
  <section class="app-form app-form--listing">
    <h1 class="app-form__title">Add listing</h1>
    <form class="ds-dialog__form listing-form" id="listing-form" data-listing-form>
      {# ── Side ─────────────────────────────────────────────────── #}
      {% <chips name="listing_side" label="Side" selected={listing_side} data_type="string" required={true}> %}
        {{ <chip value="offer" label="Offer" selected={listing_side != "request"} /> }}
        {{ <chip value="request" label="Request" selected={listing_side == "request"} /> }}
      {% </chips> %}

      {# ── Type: only IP live; rest grey / disabled ─────────────── #}
      {% <chips name="asset_type" label="Type" selected="" data_type="string" required={true}
                error_required="pick a type"> %}
        {{ <chip value="ip" label="IP" /> }}
        <button type="button" class="ds-chip is-disabled" disabled title="Soon">Domain</button>
        <button type="button" class="ds-chip is-disabled" disabled title="Soon">Property</button>
        <button type="button" class="ds-chip is-disabled" disabled title="Soon">Work</button>
        <button type="button" class="ds-chip is-disabled" disabled title="Soon">Other</button>
      {% </chips> %}

      {# Revealed only after type is chosen #}
      <div class="listing-rest" data-listing-rest hidden>

        {# ── IP-specific ───────────────────────────────────────── #}
        <div class="listing-ip" data-listing-ip hidden>
          <p class="app-form__section">IP parameters</p>

          {% <chips name="resource_kind" label="Kind" selected="PI" data_type="string" required={true}> %}
            {{ <chip value="PI" label="PI" selected={true} /> }}
            {{ <chip value="PA" label="PA" /> }}
          {% </chips> %}

          {{ <field name="geo" type="text" label="Geo" placeholder="Country / region" /> }}

          {% <chips name="operator" label="Operator" selected="RIPE" data_type="string" required={true}> %}
            {{ <chip value="RIPE" label="RIPE" selected={true} /> }}
            {{ <chip value="ASN" label="ASN" /> }}
          {% </chips> %}

          {% <chips name="size" label="Size" selected="24" data_type="string" required={true}> %}
            {{ <chip value="22" label="/22" /> }}
            {{ <chip value="23" label="/23" /> }}
            {{ <chip value="24" label="/24" selected={true} /> }}
            {{ <chip value="20" label="/20" /> }}
            {{ <chip value="19" label="/19" /> }}
            {{ <chip value="18" label="/18" /> }}
            {{ <chip value="16" label="/16" /> }}
          {% </chips> %}

          {{ <toggle name="is_public" label="Public" checked={true} /> }}
          {{ <field name="prefix" type="text" label="Network" placeholder="176.120.88.0 or 176.120.88.0/24" required={true} /> }}
        </div>

        {# ── Common ────────────────────────────────────────────── #}
        <p class="app-form__section">Listing</p>

        {{ <wysiwyg name="del_title" label="Description" height={180} /> }}

        {{ <fixed_n name="del_amount" label="Price USDC" scale={8} input_scale={0}
                    raw={0} placeholder="1500" suffix="USDC" /> }}

        {{ <wysiwyg name="del_note" label="Terms" height={160} /> }}

        {{ <file_upload name="attachments" label="Files" multiple={true}
                        hint="Drop files here or click to choose" accept=".pdf,.zip,.png,.jpg,.jpeg,.txt" /> }}

        {{ <hidden name="publish" value="true" /> }}

        <div class="app-form__actions">
          {{ <button label="Publish" type="submit" variant="primary" handler="deals_save" /> }}
          <a class="app-top__btn" href="/deals/">Cancel</a>
        </div>
      </div>
    </form>
  </section>
  {% endif %}
</main>
{% endblock %}

{% block scripts_extra %}
{{ super() }}
<script type="module" src="/static/js/listing-form.js?v={{ salt }}"></script>
{% endblock %}
