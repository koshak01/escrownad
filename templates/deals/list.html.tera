{% extends "_base.html.tera" %}

{% block title %}Market · EscrowNad{% endblock %}

{% block content %}
<main class="app-main">

  {# ── filter: plain GET form, no JS needed ─────────────────────────── #}
  <form class="board-filter" method="get" action="/deals/">
    <div class="board-filter__group">
      <span class="board-filter__label">Side</span>
      <a class="fchip{% if filter.side == '' %} is-on{% endif %}"
         href="/deals/{% if filter.asset_type %}?type={{ filter.asset_type }}{% endif %}">All</a>
      <a class="fchip{% if filter.side == 'offer' %} is-on{% endif %}" href="/deals/?side=offer">Offer</a>
      <a class="fchip{% if filter.side == 'request' %} is-on{% endif %}" href="/deals/?side=request">Request</a>
    </div>

    <div class="board-filter__group">
      <span class="board-filter__label">Status</span>
      <a class="fchip{% if filter.status == '' %} is-on{% endif %}" href="/deals/">All</a>
      {% for s in statuses %}
      <a class="fchip{% if filter.status == s %} is-on{% endif %}" href="/deals/?status={{ s }}">{{ s }}</a>
      {% endfor %}
    </div>

    <div class="board-filter__group board-filter__group--search">
      <input class="board-filter__input" type="search" name="q" value="{{ filter.query }}"
             placeholder="network, description, geo…">
      <button class="board-filter__submit" type="submit">
        <span class="ico ico--search" aria-hidden="true"></span> Search
      </button>
      {% if filter.query or filter.side or filter.status %}
      <a class="board-filter__reset" href="/deals/">Reset</a>
      {% endif %}
    </div>

    <span class="board-filter__count">{{ shown }} / {{ total }}</span>
  </form>

  <div class="data-table-wrap">
    <table class="data-table">
      <thead>
        <tr>
          <th>Lot</th>
          <th>Side</th>
          <th>Type</th>
          <th>Description</th>
          <th>Price</th>
          <th>Listed</th>
          <th>Valid until</th>
          <th>✓</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        {% if deals | length == 0 %}
        <tr>
          <td colspan="9" class="data-table__empty">No listings match.</td>
        </tr>
        {% else %}
        {% for d in deals %}
        <tr class="data-table__row" onclick="location.href='/deals/{{ d.del_hash }}/'">
          <td class="num deal-no">{{ d.deal_no }}</td>
          <td>
            {% if d.listing_side == "request" %}
              <span class="side side--request">request</span>
            {% else %}
              <span class="side side--offer">offer</span>
            {% endif %}
          </td>
          <td><code>{{ d.offer_type }}</code></td>
          <td class="desc">{{ d.description }}</td>
          <td class="num"><strong>{{ d.total_price }}</strong></td>
          <td class="num" title="{{ d.listed_at }}">{{ d.listed_at }} <span class="dim">· {{ d.listed_for }}</span></td>
          <td class="num">{{ d.expires_at }}</td>
          <td>
            {% if d.party_verified %}
              <span class="badge-ok" title="Verified">
                <span class="ico ico--check ico--sm" aria-hidden="true"></span>
              </span>
            {% else %}
              <span class="muted">—</span>
            {% endif %}
          </td>
          <td><span class="status status--{{ d.del_status }}">{{ d.del_status }}</span></td>
        </tr>
        {% endfor %}
        {% endif %}
      </tbody>
    </table>
  </div>
</main>
{% endblock %}
