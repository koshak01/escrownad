{% extends "_base.html.tera" %}

{% block title %}Offers · EscrowNad{% endblock %}

{% block content %}
<main class="app-main">
  <div class="data-table-wrap">
    <table class="data-table">
      <thead>
        <tr>
          <th>#</th>
          <th>Asset</th>
          <th>Price</th>
          <th>Seller</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        {% if deals | length == 0 %}
        <tr>
          <td colspan="5" class="data-table__empty">No offers yet.</td>
        </tr>
        {% else %}
        {% for d in deals %}
        <tr class="data-table__row" onclick="location.href='/deals/{{ d.del_id }}/'">
          <td class="num">{{ d.del_id }}</td>
          <td><code>{{ d.asset_type }}</code></td>
          <td class="num"><strong>{{ d.total_price }}</strong></td>
          <td>
            {% if d.seller_verified %}
              <span class="badge-ok">✓</span>
            {% else %}
              <span class="muted">—</span>
            {% endif %}
          </td>
          <td><span class="status status--{{ d.del_status }}">{{ d.del_status }}</span></td>
        </tr>
        {% endfor %}
        {% endif %}
      </tbody>
    </table>
  </div>
</main>
{% endblock %}
