{% extends "_base.html.tera" %}

{% block title %}Market · EscrowNad{% endblock %}

{% block content %}
<main class="app-main">

  <div class="board-bar" data-board data-scope="{{ scope }}">
    {# набор: рынок / мои / споры #}
    <div class="board-bar__group">
      <a class="fchip{% if scope == 'all' %} is-on{% endif %}" href="/deals/">Offers</a>
      <a class="fchip{% if scope == 'mine' %} is-on{% endif %}" href="/deals/?scope=mine">Mine</a>
      <a class="fchip{% if scope == 'arbitration' %} is-on{% endif %}" href="/deals/?scope=arbitration">Arbitration</a>
    </div>

    {# сторона сделки #}
    <div class="board-bar__group">
      <button type="button" class="fchip{% if filter.side == '' %} is-on{% endif %}" data-side="">All</button>
      <button type="button" class="fchip{% if filter.side == 'offer' %} is-on{% endif %}" data-side="offer">Offer</button>
      <button type="button" class="fchip{% if filter.side == 'request' %} is-on{% endif %}" data-side="request">Request</button>
    </div>

    {# живой поиск: без кнопки, таблица приходит с сервера по мере набора #}
    <div class="board-bar__search">
      <span class="ico ico--search" aria-hidden="true"></span>
      <input class="board-bar__input" type="search" data-board-search
             value="{{ filter.query }}" autocomplete="off"
             placeholder="network, description, geo…">
    </div>

    <span class="board-bar__count" data-board-count>{{ shown }} / {{ total }}</span>
  </div>

  {% if insurance_fund %}
  <p class="fund-line">
    <span class="fund-line__label">Insurance fund</span>
    <span class="fund-line__value">{{ insurance_fund }} USDC</span>
    <span class="fund-line__note">1% of every settled deal goes here — on-chain, verifiable</span>
  </p>
  {% endif %}

  {% if scope != "all" and not logged_in %}
  <p class="app-hint muted">Connect your wallet to see this list.</p>
  {% endif %}

  <div class="data-table-wrap">
    <table class="data-table">
      <thead>
        <tr>
          <th>Lot</th>
          <th>Side</th>
          <th>Type</th>
          <th>Description</th>
          <th>Price</th>
          <th>Listed</th>
          <th>Valid until</th>
          {% if show_status %}<th>Status</th>{% endif %}
        </tr>
      </thead>
      {% include "deals/_rows.html.tera" %}
    </table>
  </div>
</main>
{% endblock %}

{% block scripts_extra %}
{{ super() }}
<script type="module" src="/static/js/board.js?v={{ salt }}"></script>
{% endblock %}
