{% extends "_base.html.tera" %}

{% block title %}Market · EscrowNad{% endblock %}

{% block content %}
<main class="app-main">
  <div class="data-table-wrap">
    <table class="data-table">
      <thead>
        <tr>
          <th>#</th>
          <th>Side</th>
          <th>Type</th>
          <th>Description</th>
          <th>Price</th>
          <th>Listed</th>
          <th>✓</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        {% if deals | length == 0 %}
        <tr>
          <td colspan="8" class="data-table__empty">No listings yet.</td>
        </tr>
        {% else %}
        {% for d in deals %}
        <tr class="data-table__row" onclick="location.href='/deals/{{ d.del_id }}/'">
          <td class="num">{{ d.del_id }}</td>
          <td>
            {% if d.listing_side == "request" %}
              <span class="side side--request">request</span>
            {% else %}
              <span class="side side--offer">offer</span>
            {% endif %}
          </td>
          <td><code>{{ d.offer_type }}</code></td>
          <td class="desc">{{ d.description }}</td>
          <td class="num"><strong>{{ d.total_price }}</strong></td>
          <td class="num">{{ d.listed_for }}</td>
          <td>
            {% if d.party_verified %}
              <span class="badge-ok" title="Verified">
                <span class="ico ico--check ico--sm" aria-hidden="true"></span>
              </span>
            {% else %}
              <span class="muted">—</span>
            {% endif %}
          </td>
          <td><span class="status status--{{ d.del_status }}">{{ d.del_status }}</span></td>
        </tr>
        {% endfor %}
        {% endif %}
      </tbody>
    </table>
  </div>
</main>
{% endblock %}
