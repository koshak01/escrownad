{% extends "_base.html.tera" %}

{% block title %}Lot {{ deal_no }} · EscrowNad{% endblock %}

{% block content %}
<main class="app-main">

  {# ── bar: back · lot number · actions ────────────────────────────── #}
  <div class="deal-bar">
    <a class="deal-bar__back" href="/deals/">
      <span aria-hidden="true">←</span> Offers
    </a>

    <div class="deal-bar__id">
      <span class="deal-no">{{ deal_no }}</span>
      {% if deal.listing_side == "request" %}
        <span class="side side--request">request</span>
      {% else %}
        <span class="side side--offer">offer</span>
      {% endif %}
      <span class="status status--{{ deal.del_status }}">{{ deal.del_status }}</span>
      {% if is_expired %}<span class="status status--expired">expired</span>{% endif %}
      {% if declines > 0 %}<span class="status status--expired" title="Seller declined a deal before">{{ declines }} decline(s)</span>{% endif %}
    </div>

    <div class="deal-bar__actions">
      {% if is_creator and (deal.del_status == "draft" or deal.del_status == "verified") %}
      <form class="deal-bar__form">
        {{ <hidden name="hash" value={deal.del_hash} /> }}
        {{ <hidden name="action" value="publish" /> }}
        {{ <button label="Submit for review" type="submit" handler="deals_action" variant="primary" /> }}
      </form>
      {% endif %}

      {# On a live chain a purchase is a deposit. Whoever funds first has
         bought it: the lot is claimed by the contract, not by our database.
         Without a chain the older path remains — a request and the seller's
         confirmation. #}
      {% if deal.del_status == "listed" and not is_creator and not is_expired and not chain_ready %}
      <form class="deal-bar__form">
        {{ <hidden name="hash" value={deal.del_hash} /> }}
        {{ <hidden name="action" value="request" /> }}
        {% if deal.listing_side == "request" %}
        {{ <button label="I can sell" type="submit" handler="deals_action" variant="primary" /> }}
        {% else %}
        {{ <button label="I want to buy" type="submit" handler="deals_action" variant="primary" /> }}
        {% endif %}
      </form>
      {% endif %}

      {% if deal.del_status == "requested" and is_creator %}
      <form class="deal-bar__form">
        {{ <hidden name="hash" value={deal.del_hash} /> }}
        {{ <hidden name="action" value="accept" /> }}
        {% if deal.listing_side == "request" %}
        {{ <button label="Accept seller" type="submit" handler="deals_action" variant="primary" /> }}
        {% else %}
        {{ <button label="Accept buyer" type="submit" handler="deals_action" variant="primary" /> }}
        {% endif %}
      </form>
      {% endif %}

      {# Take the lot: it leaves the board and is held for the buyer until
         the seller confirms the deal. #}
      {% if deal.del_status == "listed" and not is_creator and not is_expired %}
      <form class="deal-bar__form">
        {{ <hidden name="hash" value={deal.del_hash} /> }}
        {{ <hidden name="action" value="take" /> }}
        {{ <button label="Take this lot" type="submit" handler="deals_action" variant="primary" /> }}
      </form>
      {% endif %}

      {# The seller decides the fate of the hold. #}
      {% if deal.del_status == "reserved" and is_creator %}
      <form class="deal-bar__form">
        {{ <hidden name="hash" value={deal.del_hash} /> }}
        {{ <hidden name="action" value="confirm_deal" /> }}
        {{ <button label="Confirm sale" type="submit" handler="deals_action" variant="primary" /> }}
      </form>
      <form class="deal-bar__form">
        {{ <hidden name="hash" value={deal.del_hash} /> }}
        {{ <hidden name="action" value="decline_deal" /> }}
        {{ <button label="Decline" type="submit" handler="deals_action" /> }}
      </form>
      {% endif %}

      {# The hold has expired — either side may return the lot to the board. #}
      {% if deal.del_status == "reserved" and reserve_expired and is_party %}
      <form class="deal-bar__form">
        {{ <hidden name="hash" value={deal.del_hash} /> }}
        {{ <hidden name="action" value="release_reserve" /> }}
        {{ <button label="Release reservation" type="submit" handler="deals_action" /> }}
      </form>
      {% endif %}

      {% if chain_ready and not is_creator and not is_expired and deal.del_status == "accepted" %}
        <button type="button" class="app-top__cta app-top__cta--solid"
                data-escrow-pay
                data-hash="{{ deal.del_hash }}"
                data-chain-id="{{ chain.chain_id }}"
                data-chain-id-hex="{{ chain.chain_id_hex }}"
                data-rpc-url="{{ chain.rpc_url }}"
                data-usdc="{{ chain.usdc }}"
                data-lock="{{ chain.lock }}"
                data-deal-id="{{ chain.deal_id }}"
                data-condition-hash="{{ chain.condition_hash }}"
                data-seller="{{ chain.seller }}"
                data-amount-units="{{ chain.amount_units }}"
                data-deadline="{{ chain.deadline }}">
          Deposit {{ price_raw | fixed_n(scale=8) }} USDC
        </button>
      {# The stand-in payment, for running without a chain. Shown only when
         there is no chain at all — with one configured, paying means paying,
         and the button above is the only way. #}
      {% elif not chain_ready and deal.del_status == "accepted" and is_buyer %}
        <form class="deal-bar__form">
          {{ <hidden name="hash" value={deal.del_hash} /> }}
          {{ <hidden name="action" value="fund" /> }}
          {{ <button label="Deposit USDC (local run)" type="submit" handler="deals_action" variant="primary" /> }}
        </form>
      {% endif %}

      {% if deal.del_status == "funded" and is_seller %}
      <form class="deal-bar__form">
        {{ <hidden name="hash" value={deal.del_hash} /> }}
        {{ <hidden name="action" value="start_prepare" /> }}
        {{ <button label="Start preparation" type="submit" handler="deals_action" variant="primary" /> }}
      </form>
      {% endif %}

      {% if deal.del_status == "preparing" and is_seller %}
      <form class="deal-bar__form">
        {{ <hidden name="hash" value={deal.del_hash} /> }}
        {{ <hidden name="action" value="mark_prepared" /> }}
        {{ <button label="Mark ready" type="submit" handler="deals_action" variant="primary" /> }}
      </form>
      {% endif %}

      {% if deal.del_status == "prepared" and is_party %}
      <form class="deal-bar__form">
        {{ <hidden name="hash" value={deal.del_hash} /> }}
        {{ <hidden name="action" value="confirm_intent" /> }}
        {{ <button label="Confirm intent" type="submit" handler="deals_action" variant="primary" /> }}
      </form>
      {% endif %}

      {% if is_party and deal.del_status != "released" and deal.del_status != "refunded" and deal.del_status != "cancelled" %}
      <form class="deal-bar__form">
        {{ <hidden name="hash" value={deal.del_hash} /> }}
        {{ <hidden name="action" value="cancel" /> }}
        {{ <button label="Cancel" type="submit" handler="deals_action" /> }}
      </form>
      {% endif %}
    </div>
  </div>

  {# ── tiles ───────────────────────────────────────────────────────── #}
  <div class="deal-grid">

    <section class="tile tile--price">
      <span class="tile__label">Price</span>
      <span class="tile__value tile__value--xl">{{ price_raw | fixed_n(scale=8) }}</span>
      <span class="tile__unit">USDC</span>
    </section>

    <section class="tile">
      <span class="tile__label">Resource</span>
      <span class="tile__value mono">{{ shown_prefix }}</span>
      <span class="tile__sub">
        {% if addresses %}{{ addresses | fixed_n(scale=0) }} addresses · {% endif %}{{ deal.resource_kind }} · {{ deal.rir }}
        {% if not may_see_prefix %}<br><span class="tile__locked">exact network opens after you fund the deal</span>{% endif %}
      </span>
    </section>

    <section class="tile">
      <span class="tile__label">Registry transfer</span>
      <span class="tile__value">{{ deal.from_org | default(value="—") }}</span>
      <span class="tile__sub">
        → {{ deal.to_org | default(value="buyer organisation") }}
        {% if not oracle_auto %}<br><strong>{{ deal.rir }}</strong>: manual confirmation{% endif %}
      </span>
    </section>

    {% if deal.del_status == "reserved" %}
    <section class="tile tile--price">
      <span class="tile__label">Reserved</span>
      <span class="tile__value mono">{{ reserved_until }}</span>
      <span class="tile__sub">
        {% if reserve_expired %}
          reservation expired — the lot can go back to the board
        {% elif is_buyer %}
          the lot is held for you until the seller confirms
        {% elif is_creator %}
          a buyer is waiting for your answer
        {% else %}
          taken by another buyer
        {% endif %}
      </span>
    </section>
    {% endif %}

    <section class="tile">
      <span class="tile__label">Timing</span>
      <span class="tile__value mono">{{ created_at }}</span>
      <span class="tile__sub">valid until {{ expires_at }}</span>
    </section>
  </div>

  {# ── description ─────────────────────────────────────────────────── #}
  <section class="card">
    <h2 class="card__title">Description</h2>
    <div class="rich">{{ deal.del_title | default(value="—") | safe }}</div>
  </section>

  {% if deal.del_note %}
  <section class="card">
    <h2 class="card__title">Terms</h2>
    <div class="rich">{{ deal.del_note | safe }}</div>
  </section>
  {% endif %}

  {# ── parties and chain ───────────────────────────────────────────── #}
  {# Explorer links: real 0x addresses/txs open Monadscan in a new tab.
     Mock stand-ins stay plain text. Template vars come from `explorer` in
     pages/deals.rs (DealShowPage). #}
  <div class="deal-grid deal-grid--wide">
    <section class="card">
      <h2 class="card__title">Parties</h2>
      <div class="party">
        <span class="party__role">Seller</span>
        {% if explorer.seller %}
        <a class="party__addr party__link" href="{{ explorer.seller }}" target="_blank" rel="noopener noreferrer" title="Open seller wallet on Monad explorer">{{ deal.seller_wallet }}</a>
        {% else %}
        <code class="party__addr">{{ deal.seller_wallet | default(value="—") }}</code>
        {% endif %}
        {% if seller_verified %}<span class="badge-ok" title="Completed deal before">✓</span>{% endif %}
      </div>
      <div class="party">
        <span class="party__role">Buyer</span>
        {% if explorer.buyer %}
        <a class="party__addr party__link" href="{{ explorer.buyer }}" target="_blank" rel="noopener noreferrer" title="Open buyer wallet on Monad explorer">{{ deal.buyer_wallet }}</a>
        {% else %}
        <code class="party__addr">{{ deal.buyer_wallet | default(value="—") }}</code>
        {% endif %}
      </div>
    </section>

    <section class="card">
      <h2 class="card__title">On-chain</h2>
      {% if explorer.contract %}
      <div class="party">
        <span class="party__role">Contract</span>
        <a class="party__addr party__link" href="{{ explorer.contract }}" target="_blank" rel="noopener noreferrer" title="Open EscrowLock on Monad explorer (verified source)">{{ explorer.contract_label }}</a>
      </div>
      {% endif %}
      <div class="party">
        <span class="party__role">Lock</span>
        {% if explorer.lock_tx %}
        <a class="party__addr party__link" href="{{ explorer.lock_tx }}" target="_blank" rel="noopener noreferrer" title="Open lock transaction on Monad explorer">{{ deal.lock_tx }}</a>
        {% else %}
        <code class="party__addr">{{ deal.lock_tx | default(value="—") }}</code>
        {% endif %}
      </div>
      <div class="party">
        <span class="party__role">Release</span>
        {% if explorer.release_tx %}
        <a class="party__addr party__link" href="{{ explorer.release_tx }}" target="_blank" rel="noopener noreferrer" title="Open release transaction on Monad explorer">{{ deal.release_tx }}</a>
        {% else %}
        <code class="party__addr">{{ deal.release_tx | default(value="—") }}</code>
        {% endif %}
      </div>
      {# The lot as a verified asset. Issued when the operator approved it, with
         the identity check built in: it cannot be transferred to a wallet
         without a valid identity, here or anywhere else. #}
      {% if deal.asset_token %}
      <div class="party">
        <span class="party__role">Asset</span>
        {% if explorer.asset %}
        <a class="party__addr party__link" href="{{ explorer.asset }}" target="_blank" rel="noopener noreferrer" title="Open verified asset on Monad explorer">{{ deal.asset_token }}</a>
        {% else %}
        <code class="party__addr">{{ deal.asset_token }}</code>
        {% endif %}
      </div>
      <p class="muted tile__sub">Holders must carry a valid Cleanverse identity — a transfer to any other wallet reverts on-chain, on this platform or off it.</p>
      {% elif deal.asset_request %}
      <div class="party">
        <span class="party__role">Asset</span>
        <code class="party__addr">being issued…</code>
      </div>
      {% endif %}
      {% if deal.del_status == "awaiting_proof" %}
      <p class="muted tile__sub">Waiting for the RIPE fact. USDC stays locked until it matches.</p>
      {% elif deal.del_status == "released" %}
      <p class="muted tile__sub">Released — USDC paid to the seller. Open <strong>Release</strong> above to verify on the explorer.</p>
      {% endif %}
      <p class="muted tile__sub"><a href="/oracle/">How does the oracle work?</a></p>
    </section>
  </div>

  {% if not usr_id %}
  <p class="app-hint muted">Connect your wallet to act on this lot.</p>
  {% endif %}
</main>
{% endblock %}

{% block scripts_extra %}
{{ super() }}
<script type="module" src="/static/js/escrow.js?v={{ salt }}"></script>
{% endblock %}
