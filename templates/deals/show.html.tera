{% extends "_base.html.tera" %}

{% block title %}{{ deal.del_title | default(value="Offer") }} · EscrowNad{% endblock %}

{% block content %}
<main class="app-main">
  <p class="muted"><a href="/deals/">← Offers</a></p>

  <header class="deal-hero">
    <span class="status status--{{ deal.del_status }}">{{ deal.del_status }}</span>
    <h1 class="app-main__title">{{ deal.del_title | default(value="Offer") }}</h1>
    <p class="app-main__sub muted">{{ deal.del_note | default(value="") }}</p>
  </header>

  <ol class="lifecycle">
    <li class="{% if deal.del_status == 'draft' or deal.del_status == 'verified' %}done{% endif %}">Draft / verify</li>
    <li class="{% if deal.del_status == 'listed' %}done{% endif %}">Listed</li>
    <li class="{% if deal.del_status == 'requested' %}done{% endif %}">Buy request</li>
    <li class="{% if deal.del_status == 'accepted' %}done{% endif %}">Accepted</li>
    <li class="{% if deal.del_status == 'funded' %}done{% endif %}">USDC funded</li>
    <li class="{% if deal.del_status == 'preparing' or deal.del_status == 'prepared' %}done{% endif %}">Seller prep</li>
    <li class="{% if deal.del_status == 'awaiting_proof' %}done{% endif %}">Confirm + wait oracle</li>
    <li class="{% if deal.del_status == 'released' %}done{% endif %}{% if deal.del_status == 'refunded' or deal.del_status == 'dispute' or deal.del_status == 'cancelled' %}fail{% endif %}">Released</li>
  </ol>

  <section class="card">
    <h2>Details</h2>
    <dl class="ds-dl">
      <dt>Resource</dt><dd><code>{{ deal.resource_kind }}</code> · <code>{{ deal.prefix }}</code></dd>
      <dt>From → To</dt><dd>{{ deal.from_org | default(value="?") }} → {{ deal.to_org | default(value="?") }}</dd>
      <dt>Verified</dt><dd>{{ deal.soft_verified }}</dd>
      <dt>Seller wallet</dt><dd><code>{{ deal.seller_wallet | default(value="—") }}</code></dd>
      <dt>Buyer wallet</dt><dd><code>{{ deal.buyer_wallet | default(value="—") }}</code></dd>
      <dt>Lock tx</dt><dd><code>{{ deal.lock_tx | default(value="—") }}</code></dd>
      <dt>Release tx</dt><dd><code>{{ deal.release_tx | default(value="—") }}</code></dd>
    </dl>
  </section>

  <section class="card deal-actions">
    <h2>Actions</h2>

    {% if deal.del_status == "draft" or deal.del_status == "verified" %}
    <form class="ds-dialog__form">
      {{ <hidden name="id" value={deal.del_id | str} data_type="integer" /> }}
      {{ <hidden name="action" value="publish" /> }}
      {{ <button label="Verify &amp; publish" type="submit" handler="deals_action" variant="primary" /> }}
    </form>
    {% endif %}

    {% if deal.del_status == "listed" %}
    <form class="ds-dialog__form">
      {{ <hidden name="id" value={deal.del_id | str} data_type="integer" /> }}
      {{ <hidden name="action" value="request" /> }}
      {{ <button label="I want to buy" type="submit" handler="deals_action" variant="primary" /> }}
    </form>
    <p class="muted">Connect wallet first so your address is bound as buyer.</p>
    {% endif %}

    {% if deal.del_status == "requested" %}
    <form class="ds-dialog__form">
      {{ <hidden name="id" value={deal.del_id | str} data_type="integer" /> }}
      {{ <hidden name="action" value="accept" /> }}
      {{ <button label="Accept buyer" type="submit" handler="deals_action" variant="primary" /> }}
    </form>
    {% endif %}

    {% if deal.del_status == "accepted" %}
    <form class="ds-dialog__form">
      {{ <hidden name="id" value={deal.del_id | str} data_type="integer" /> }}
      {{ <hidden name="action" value="fund" /> }}
      {{ <button label="Deposit USDC (mock)" type="submit" handler="deals_action" variant="primary" /> }}
    </form>
    <p class="muted">Buyer: deposit settlement USDC into the on-chain lock.</p>
    {% endif %}

    {% if deal.del_status == "funded" %}
    <form class="ds-dialog__form">
      {{ <hidden name="id" value={deal.del_id | str} data_type="integer" /> }}
      {{ <hidden name="action" value="start_prepare" /> }}
      {{ <button label="Start preparation" type="submit" handler="deals_action" variant="primary" /> }}
    </form>
    <p class="muted">Seller: begin transfer preparation (RIPE / registry work).</p>
    {% endif %}

    {% if deal.del_status == "preparing" %}
    <form class="ds-dialog__form">
      {{ <hidden name="id" value={deal.del_id | str} data_type="integer" /> }}
      {{ <hidden name="action" value="mark_prepared" /> }}
      {{ <button label="Mark ready ✓" type="submit" handler="deals_action" variant="primary" /> }}
    </form>
    {% endif %}

    {% if deal.del_status == "prepared" %}
    <form class="ds-dialog__form">
      {{ <hidden name="id" value={deal.del_id | str} data_type="integer" /> }}
      {{ <hidden name="action" value="confirm_intent" /> }}
      {{ <button label="Confirm intent" type="submit" handler="deals_action" variant="primary" /> }}
    </form>
    <p class="muted">Both parties confirm. Then wait for RIPE oracle fact → release to seller.</p>
    {% endif %}

    {% if deal.del_status == "awaiting_proof" or deal.del_status == "funded" %}
      {% if deal.del_status == "awaiting_proof" %}
      <p class="muted">Waiting for RIPE proof (observer). USDC stays locked until fact match.</p>
      {% endif %}
    {% endif %}

    {% if deal.del_status == "released" %}
    <p class="status status--released">Released — USDC paid to seller.</p>
    {% endif %}

    {% if deal.del_status != "released" and deal.del_status != "refunded" and deal.del_status != "cancelled" %}
    <form class="ds-dialog__form">
      {{ <hidden name="id" value={deal.del_id | str} data_type="integer" /> }}
      {{ <hidden name="action" value="cancel" /> }}
      {{ <button label="Cancel / refund" type="submit" handler="deals_action" /> }}
    </form>
    {% endif %}

    <p class="muted"><a href="/oracle/">How does the oracle work?</a></p>
  </section>
</main>
{% endblock %}
